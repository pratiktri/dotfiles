# Read by lua_ls's formatter (EmmyLuaCodeStyle) & Neovim's built-in editorconfig support
# Options: https://github.com/CppCXY/EmmyLuaCodeStyle/blob/master/lua.template.editorconfig
root = true

[*.lua]
indent_style = space
indent_size = 4
end_of_line = lf
max_line_length = 160
quote_style = double

# Line up consecutive `=`, table fields & trailing comments
align_continuous_assign_statement = true
align_continuous_rect_table_field = true
align_continuous_inline_comment = true
